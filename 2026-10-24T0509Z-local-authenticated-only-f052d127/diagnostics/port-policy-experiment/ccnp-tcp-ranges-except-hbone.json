{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumClusterwideNetworkPolicy",
  "metadata": {
    "name": "multiport-hbone-only"
  },
  "spec": {
    "endpointSelector": {
      "matchLabels": {
        "app": "cmtc-multiport-server",
        "k8s:io.kubernetes.pod.namespace": "mtls-spike"
      }
    },
    "ingress": [
      {
        "fromEndpoints": [
          {
            "matchLabels": {
              "k8s:io.kubernetes.pod.namespace": "mtls-spike"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [
              {
                "port": "15008",
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    ],
    "ingressDeny": [
      {
        "toPorts": [
          {
            "ports": [
              {
                "port": "1",
                "endPort": 15007,
                "protocol": "TCP"
              },
              {
                "port": "15009",
                "endPort": 65535,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    ]
  }
}
