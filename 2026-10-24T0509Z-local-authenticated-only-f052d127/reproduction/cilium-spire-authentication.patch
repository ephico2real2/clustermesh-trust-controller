+	}
+	if c.EnableZTunnel && c.CAType != CATypeInternal && c.CAType != CATypeSpire {
+		return fmt.Errorf("unsupported ztunnel-ca-type %q: expected internal or spire", c.CAType)
+	}
+	if c.EnableZTunnel {
