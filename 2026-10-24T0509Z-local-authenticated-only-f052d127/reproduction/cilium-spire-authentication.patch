diff --git a/operator/pkg/ztunnel/spire/startup.go b/operator/pkg/ztunnel/spire/startup.go
new file mode 100644
index 0000000000..ee8f619572
--- /dev/null
+++ b/operator/pkg/ztunnel/spire/startup.go
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package spire
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/cilium/hive/cell"
+	entryv1 "github.com/spiffe/spire-api-sdk/proto/spire/api/server/entry/v1"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/cilium/cilium/pkg/backoff"
+	"github.com/cilium/cilium/pkg/logging/logfields"
+)
+
+// Bound startup independently of the individual connection/RPC timeout.
+const (
+	spireStartupTimeout = 3 * time.Minute
+	logStage            = "stage"
+	logDeadline         = "deadline"
+)
+
+type spireConnection struct {
+	entry entryv1.EntryClient
+	close func()
+}
+
+func acknowledgeServer(ctx context.Context, entry entryv1.EntryClient) error {
+	_, err := entry.CountEntries(ctx, &entryv1.CountEntriesRequest{})
+	return err
+}
+
+func (c *Client) run(ctx context.Context, health cell.Health) error {
+	delay := backoff.Exponential{Logger: c.log, Min: 100 * time.Millisecond, Max: 10 * time.Second, Jitter: true}
+	return c.runWithConnector(ctx, health, c.connect, delay.Duration)
+}
+
+func (c *Client) runWithConnector(ctx context.Context, health cell.Health,
+	connect func(context.Context) (*spireConnection, error), delay func(int) time.Duration,
+) error {
+	startupCtx, cancel := context.WithTimeout(ctx, spireStartupTimeout)
+	defer cancel()
+	deadline, _ := startupCtx.Deadline()
+	c.log.InfoContext(ctx, "Starting SPIRE initialization",
+		logStage, "server-ack",
+		logfields.Event, "startup",
+		logDeadline, deadline,
+		logfields.Address, c.cfg.SpireServerAddress,
+		logfields.Timeout, spireStartupTimeout)
+	conn, err := c.initialize(startupCtx, health, connect, delay)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil
+		}
+		c.log.ErrorContext(ctx, "SPIRE initialization failed",
+			logStage, "server-ack",
+			logfields.Event, "startup-failed",
+			logfields.Error, err)
+		return err
+	}
+	defer conn.close()
+	c.entryMutex.Lock()
+	c.entry = conn.entry
+	c.entryMutex.Unlock()
+	close(c.initialized)
+	health.OK("Authenticated SPIRE server acknowledgment received")
+	<-ctx.Done()
+	c.entryMutex.Lock()
+	c.entry = nil
+	c.entryMutex.Unlock()
+	return nil
+}
+
+func (c *Client) initialize(ctx context.Context, health cell.Health,
+	connect func(context.Context) (*spireConnection, error), delay func(int) time.Duration,
+) (*spireConnection, error) {
+	start := time.Now()
+	for attempt := 1; ; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return nil, fmt.Errorf("SPIRE startup: %w", err)
+		}
+		conn, err := connect(ctx)
+		if err == nil {
+			c.log.InfoContext(ctx, "SPIRE server acknowledged authenticated API request",
+				logStage, "server-ack",
+				logfields.Event, "ack",
+				logfields.Attempt, attempt,
+				logfields.ElapsedDuration, time.Since(start),
+				logfields.Address, c.cfg.SpireServerAddress)
+			return conn, nil
+		}
+		// These indicate invalid credentials, permissions or configuration,
+		// not a dependency that simply has not finished starting.
+		switch status.Code(err) {
+		case codes.PermissionDenied, codes.Unauthenticated, codes.InvalidArgument, codes.FailedPrecondition:
+			return nil, fmt.Errorf("SPIRE startup rejected: %w", err)
+		}
+		if ctx.Err() != nil {
+			return nil, fmt.Errorf("SPIRE startup after %d attempts: %w", attempt, ctx.Err())
+		}
+		next := delay(attempt)
+		deadline, hasDeadline := ctx.Deadline()
+		if hasDeadline {
+			next = min(next, max(time.Until(deadline), 0))
+		}
+		health.Degraded("Waiting for authenticated SPIRE server acknowledgment", err)
+		c.log.WarnContext(ctx, "Retrying SPIRE initialization",
+			logStage, "server-ack",
+			logfields.Event, "retry",
+			logfields.Attempt, attempt,
+			logfields.ElapsedDuration, time.Since(start),
+			logfields.Backoff, next,
+			logDeadline, deadline,
+			logfields.Address, c.cfg.SpireServerAddress,
+			logfields.Error, err)
+		timer := time.NewTimer(next)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return nil, fmt.Errorf("SPIRE startup after %d attempts: %w", attempt, ctx.Err())
+		case <-timer.C:
+		}
+	}
+}
diff --git a/operator/pkg/ztunnel/spire/startup_test.go b/operator/pkg/ztunnel/spire/startup_test.go
new file mode 100644
index 0000000000..68945b89d0
--- /dev/null
+++ b/operator/pkg/ztunnel/spire/startup_test.go
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package spire
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log/slog"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/cilium/hive/cell"
+	"github.com/cilium/hive/hivetest"
+	entryv1 "github.com/spiffe/spire-api-sdk/proto/spire/api/server/entry/v1"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/status"
+	"google.golang.org/grpc/test/bufconn"
+
+	"github.com/cilium/cilium/pkg/logging/logfields"
+)
+
+func TestSpireStartupRetryLogsAndAcknowledgment(t *testing.T) {
+	var logs bytes.Buffer
+	c := &Client{log: slog.New(slog.NewJSONHandler(&logs, nil)).With(logfields.LogSubsys, "spire-client")}
+	health, _ := cell.NewSimpleHealth()
+	attempts := 0
+	expected := &spireConnection{}
+	actual, err := c.initialize(t.Context(), health, func(context.Context) (*spireConnection, error) {
+		attempts++
+		if attempts < 3 {
+			return nil, status.Error(codes.Unavailable, "SPIRE restarting")
+		}
+		return expected, nil
+	}, func(int) time.Duration { return time.Millisecond })
+	require.NoError(t, err)
+	require.Same(t, expected, actual)
+	require.Equal(t, 3, attempts)
+	decoder := json.NewDecoder(&logs)
+	for i := 1; i <= 3; i++ {
+		var record map[string]any
+		require.NoError(t, decoder.Decode(&record))
+		require.Equal(t, "spire-client", record[logfields.LogSubsys])
+		require.Equal(t, "server-ack", record["stage"])
+		require.Equal(t, float64(i), record[logfields.Attempt])
+		require.Contains(t, record, logfields.ElapsedDuration)
+		if i < 3 {
+			require.Equal(t, "retry", record["event"])
+			require.Contains(t, record, logfields.Backoff)
+			require.Contains(t, record, logfields.Error)
+		} else {
+			require.Equal(t, "ack", record["event"])
+		}
+	}
+}
+
+func TestSpireStartupRejectsPermanentFailures(t *testing.T) {
+	for _, code := range []codes.Code{codes.PermissionDenied, codes.Unauthenticated, codes.InvalidArgument, codes.FailedPrecondition} {
+		t.Run(code.String(), func(t *testing.T) {
+			c := &Client{log: hivetest.Logger(t)}
+			health, _ := cell.NewSimpleHealth()
+			attempts := 0
+			conn, err := c.initialize(t.Context(), health, func(context.Context) (*spireConnection, error) {
+				attempts++
+				return nil, status.Error(code, "rejected")
+			}, func(int) time.Duration { t.Fatal("permanent errors must not retry"); return 0 })
+			require.Nil(t, conn)
+			require.ErrorContains(t, err, "startup rejected")
+			require.Equal(t, 1, attempts)
+		})
+	}
+}
+
+func TestSpireStartupDeadlineAndCancellation(t *testing.T) {
+	for _, canceled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "deadline", true: "canceled"}[canceled], func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+			defer cancel()
+			if canceled {
+				cancel()
+			}
+			c := &Client{log: hivetest.Logger(t)}
+			health, _ := cell.NewSimpleHealth()
+			attempts := 0
+			conn, err := c.initialize(ctx, health, func(context.Context) (*spireConnection, error) {
+				attempts++
+				return nil, status.Error(codes.Unavailable, "offline")
+			}, func(int) time.Duration { return time.Hour })
+			require.Nil(t, conn)
+			require.ErrorIs(t, err, ctx.Err())
+			if canceled {
+				require.Zero(t, attempts)
+			}
+		})
+	}
+}
+
+func TestSpireStartupPublishesOnlyAfterACKAndClosesOnStop(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	c := &Client{log: hivetest.Logger(t), initialized: make(chan struct{})}
+	health, _ := cell.NewSimpleHealth()
+	request := make(chan struct{})
+	reply := make(chan struct{})
+	var closed atomic.Bool
+	done := make(chan error, 1)
+	go func() {
+		done <- c.runWithConnector(ctx, health, func(context.Context) (*spireConnection, error) {
+			close(request)
+			<-reply
+			return &spireConnection{entry: mockEntryClient{}, close: func() { closed.Store(true) }}, nil
+		}, func(int) time.Duration { return time.Millisecond })
+	}()
+	<-request
+	select {
+	case <-c.Initialized():
+		t.Fatal("initialized before authenticated response")
+	default:
+	}
+	close(reply)
+	select {
+	case <-c.Initialized():
+	case <-time.After(5 * time.Second):
+		t.Fatal("acknowledgment not published")
+	}
+	cancel()
+	require.NoError(t, <-done)
+	require.True(t, closed.Load())
+	require.Nil(t, c.entry)
+}
+
+type acknowledgmentServer struct {
+	entryv1.UnimplementedEntryServer
+	code codes.Code
+}
+
+func (s acknowledgmentServer) CountEntries(context.Context, *entryv1.CountEntriesRequest) (*entryv1.CountEntriesResponse, error) {
+	if s.code != codes.OK {
+		return nil, status.Error(s.code, "server did not acknowledge")
+	}
+	return &entryv1.CountEntriesResponse{}, nil
+}
+
+func TestSpireServerAcknowledgmentRequiresRPCResponse(t *testing.T) {
+	for _, code := range []codes.Code{codes.OK, codes.PermissionDenied, codes.Unavailable} {
+		t.Run(code.String(), func(t *testing.T) {
+			listener := bufconn.Listen(1024 * 1024)
+			server := grpc.NewServer()
+			entryv1.RegisterEntryServer(server, acknowledgmentServer{code: code})
+			go func() { _ = server.Serve(listener) }()
+			t.Cleanup(func() { server.Stop(); _ = listener.Close() })
+			var dials atomic.Int32
+			conn, err := grpc.NewClient("passthrough:///spire-ack-test", grpc.WithTransportCredentials(insecure.NewCredentials()),
+				grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { dials.Add(1); return listener.Dial() }))
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = conn.Close() })
+			require.Zero(t, dials.Load(), "NewClient must not be mistaken for a handshake")
+			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+			defer cancel()
+			err = acknowledgeServer(ctx, entryv1.NewEntryClient(conn))
+			require.Equal(t, code, status.Code(err))
+			require.Positive(t, dials.Load())
+		})
+	}
+}
diff --git a/pkg/ztunnel/SPIRE.md b/pkg/ztunnel/SPIRE.md
new file mode 100644
index 0000000000..0bac8ecb4d
--- /dev/null
+++ b/pkg/ztunnel/SPIRE.md
@@ -0,0 +1,78 @@
+# SPIRE workload credentials
+
+This slice implements the credential-delivery prerequisite for CMTC-101. It does
+not enable ClusterMesh compatibility, authorization production, persistent
+packet admission, or a Protected status.
+
+With `encryption.ztunnel.ca.type=spire`, enable
+`authentication.mutual.spire.enabled`. The agent serves ADS using only its
+bootstrap TLS server key/certificate chain and does not load or register the
+internal workload CA. Missing ADS TLS credentials fail startup. Internal mode
+retains its existing signer and requires all four Secret keys.
+
+The proxy receives the SPIRE admin socket and node CRI socket for delegated
+PID attestation. The bundled SPIRE installer registers an attested node alias
+`/ztunnel` for operator-created workload entries, and a separate workload
+identity `/ztunnel-proxy` for the proxy service account. Only that identity is
+added to the existing delegated-identity allowlist. These are distinct from
+application namespace/service-account identities.
+
+The configured SPIFFE trust domain is carried in both initial and incremental
+Address resources. Cilium ztunnel v1.0.0, commit
+`5bb9cf256b10a209ae9bc0624ddfbf27dbc439de`, uses `SPIRE_ENABLED` to select its
+SPIRE client exclusively. Its locked spire-api 0.3.9 client reads
+`SPIRE_ADMIN_ENDPOINT_SOCKET`; the proxy selects its trust bundle using
+`Config.cluster_domain`, so SPIRE mode sets `CLUSTER_DOMAIN` as well as
+`TRUST_DOMAIN`. The chart keeps proxy DNS capture disabled. These settings do
+not alter Kubernetes DNS configuration. Verify any future proxy pin against
+these source contracts before changing them.
+
+The CA choice does not configure a cert-manager issuer for SPIRE automatically.
+CMTC-101's isolated runtime fixture supplies the cert-manager UpstreamAuthority
+and namespace-scoped CertificateRequest RBAC. The organizational root key stays
+outside the cluster, cluster issuer keys remain in cert-manager, and SPIRE holds
+its own intermediate key. Agent nodes receive only the ADS TLS server key and
+public chain. CA depth must allow root -> cluster issuer -> SPIRE intermediate
+-> workload SVID. Issuer and peer restrictions for foreign-cluster identities
+remain CMTC-105 acceptance work.
+
+Local tests cover absence of the signing RPC/key loader in SPIRE mode, existing
+internal signer behavior, unavailable-signer startup failure, invalid backend
+and domain rejection, and issuer-domain propagation over actual initial and
+incremental ADS streams. The CMTC fixture must additionally prove real SVID
+issuance, peer identity, encrypted packets and negative cases before any runtime
+mTLS acceptance is reported.
+
+The operator's SPIRE initialization is a lifecycle-managed Hive job. It uses
+Cilium's injected slog logger and standard logfields for attempt, elapsed time,
+backoff, deadline, server address and underlying errors. Transient startup
+failures use jittered exponential backoff capped at ten seconds within a
+three-minute startup deadline; each connection attempt retains the configured
+connection timeout. Shutdown cancels both an RPC and a pending retry. Explicit
+authentication, permission and configuration rejections fail the job and its
+Hive health report. Failed attempts release their X509 source and gRPC client;
+successful resources remain alive until job shutdown.
+
+Initialization is acknowledged only after an authenticated CountEntries RPC
+responds. A lazy grpc.NewClient is not a connection acknowledgment. This ACK
+does not establish application SVID delivery, policy installation or packet
+protection. The broader dependency/registration/proxy recovery work is tracked
+in [CMTC issue #7](https://github.com/ephico2real2/clustermesh-trust-controller/issues/7).
+
+## Experimental authenticated-only inbound policy
+
+`encryption.ztunnel.requireMtls=true` (`ztunnel-require-mtls`) publishes a native
+ztunnel GLOBAL DENY rule matching the absence of an authenticated TLS principal.
+It has no application-port predicates. The receiving plaintext listener passes
+no peer identity to RBAC; HBONE uses the verified TLS peer. Cilium currently
+supplies workload records only for enrolled namespaces, so this policy applies
+to the workloads handled by the ztunnel, not arbitrary platform pods.
+
+This option defaults to false while admission and platform compatibility are
+being qualified. The desired policy is installed before ADS accepts connections,
+but the pinned proxy can permit traffic while policy is absent. This is not a
+persistent fail-closed gate, a complete Cilium authorization compiler, or a
+`Protected` status. Startup/restart, policy loss, mandatory capture and legitimate
+platform health probes must be checked independently. Incompatible Helm/agent
+profiles reject the option instead of silently ignoring it. Do not substitute
+port-80 (or enumerated-port) network-policy denies for workload authentication.
