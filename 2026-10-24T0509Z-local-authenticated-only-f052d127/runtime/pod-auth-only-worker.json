{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "auth-only-worker",
    "namespace": "mtls-plaintext-control",
    "labels": {
      "app": "cmtc-auth-only-control"
    },
    "annotations": {
      "security.cmtc.io/fixture-id": "24d6aece-e148-480b-8afb-2943d0a54356"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "cmtc-mtls-worker"
    },
    "tolerations": [
      {
        "key": "node-role.kubernetes.io/control-plane",
        "operator": "Exists",
        "effect": "NoSchedule"
      }
    ],
    "automountServiceAccountToken": false,
    "restartPolicy": "Never",
    "containers": [
      {
        "name": "probe",
        "image": "alpine:3.20",
        "command": [
          "sleep",
          "900"
        ],
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "memory": "32Mi"
          }
        }
      }
    ]
  }
}
