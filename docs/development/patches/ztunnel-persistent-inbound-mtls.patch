From d79d3dfaef3d7afeb3552ea53cf90213141e95d3 Mon Sep 17 00:00:00 2001
From: ephico2real2 <ephico2real@gmail.com>
Date: Sat, 24 Oct 2026 07:09:46 -0500
Subject: [PATCH] auth: require verified inbound peers independently of policy
 delivery

Add an opt-in immutable authentication floor at the shared inbound RBAC check. Reject missing workload policy references in this profile and preserve explicit DENY decisions. The proxy-mtls command makes old binaries reject strict startup instead of silently ignoring an unknown setting.

Local Linux ARM64 validation: three new authentication tests and three existing RBAC regression tests pass. Formatting and build pass. Clippy passes with three categories excepted for five pre-existing warnings in unchanged upstream files. Runtime qualification remains separate; no full fail-closed claim.

Signed-off-by: ephico2real2 <ephico2real@gmail.com>
---
 src/config.rs |   5 +++
 src/main.rs   |  13 ++++--
 src/proxy.rs  |   6 +++
 src/state.rs  | 121 +++++++++++++++++++++++++++++++++++++++++++++++++-
 4 files changed, 140 insertions(+), 5 deletions(-)

diff --git a/src/config.rs b/src/config.rs
index 636bd22..4ecd80f 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -35,6 +35,7 @@ use crate::{identity, state};
 use {crate::test_helpers::MpscAckReceiver, crate::xds::LocalConfig, tokio::sync::Mutex};
 
 const ENABLE_PROXY: &str = "ENABLE_PROXY";
+const REQUIRE_INBOUND_MTLS: &str = "REQUIRE_INBOUND_MTLS";
 const KUBERNETES_SERVICE_HOST: &str = "KUBERNETES_SERVICE_HOST";
 const NETWORK: &str = "NETWORK";
 const NODE_NAME: &str = "NODE_NAME";
@@ -200,6 +201,9 @@ impl serde::Serialize for MetadataVector {
 pub struct Config {
     /// If true, the HBONE proxy will be used.
     pub proxy: bool,
+    /// Require a verified TLS peer before inbound authorization, independently
+    /// of dynamic policy delivery. Missing required policy references deny.
+    pub require_inbound_mtls: bool,
     /// If true, a DNS proxy will be used.
     pub dns_proxy: bool,
 
@@ -730,6 +734,7 @@ pub fn construct_config(pc: ProxyConfig) -> Result<Config, Error> {
 
     validate_config(Config {
         proxy: parse_default(ENABLE_PROXY, true)?,
+        require_inbound_mtls: parse_default(REQUIRE_INBOUND_MTLS, false)?,
         // Enable by default; running the server is not an issue, clients still need to opt-in to sending their
         // DNS requests to Ztunnel.
         dns_proxy: pc
diff --git a/src/main.rs b/src/main.rs
index 9b2ce84..c0209f3 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -53,8 +53,11 @@ fn main() -> anyhow::Result<()> {
     let _log_flush = telemetry::setup_logging();
 
     // For now we don't need a complex CLI, so rather than pull in dependencies just use basic argv[1]
-    match std::env::args().nth(1).as_deref() {
-        None | Some("proxy") => (),
+    let require_inbound_mtls = match std::env::args().nth(1).as_deref() {
+        None | Some("proxy") => false,
+        // A distinct command makes older proxy images fail startup instead of
+        // silently ignoring an unknown security environment setting.
+        Some("proxy-mtls") => true,
         Some("version") => return version(),
         Some("help") => return help(),
         Some(unknown) => {
@@ -69,8 +72,9 @@ fn main() -> anyhow::Result<()> {
         .build()
         .unwrap()
         .block_on(async move {
-            let config = Arc::new(config::parse_config()?);
-            proxy(config).await
+            let mut config = config::parse_config()?;
+            config.require_inbound_mtls |= require_inbound_mtls;
+            proxy(Arc::new(config)).await
         })
 }
 
@@ -82,6 +86,7 @@ Istio Ztunnel ({version})
 
 Commands:
 proxy (default) - Start the ztunnel proxy
+proxy-mtls      - Require verified inbound TLS peers and all referenced policies
 version         - Print the version of ztunnel
 help            - Print commands and version of ztunnel"
     );
diff --git a/src/proxy.rs b/src/proxy.rs
index d66802b..d32dc3d 100644
--- a/src/proxy.rs
+++ b/src/proxy.rs
@@ -377,6 +377,8 @@ pub struct Addresses {
 
 #[derive(Debug, PartialEq, Eq)]
 pub enum AuthorizationRejectionError {
+    AuthenticationRequired,
+    MissingPolicy(Strng),
     NoWorkload,
     WorkloadMismatch,
     ExplicitlyDenied(Strng, Strng),
@@ -385,6 +387,10 @@ pub enum AuthorizationRejectionError {
 impl fmt::Display for AuthorizationRejectionError {
     fn fmt(&self, fmt: &mut fmt::Formatter<'_>) -> fmt::Result {
         match self {
+            Self::AuthenticationRequired => write!(fmt, "verified TLS peer required"),
+            Self::MissingPolicy(policy) => {
+                write!(fmt, "required authorization unavailable: {policy}")
+            }
             Self::NoWorkload => write!(fmt, "workload not found"),
             Self::WorkloadMismatch => write!(fmt, "workload mismatch"),
             Self::ExplicitlyDenied(a, b) => write!(fmt, "explicitly denied by: {a}/{b}"),
diff --git a/src/state.rs b/src/state.rs
index b0ea11e..5a0b9f0 100644
--- a/src/state.rs
+++ b/src/state.rs
@@ -488,6 +488,9 @@ impl ProxyState {
 /// on-demand.
 #[derive(serde::Serialize, Clone)]
 pub struct DemandProxyState {
+    /// Immutable process requirement; cannot disappear during an xDS resync.
+    #[serde(skip_serializing)]
+    require_inbound_mtls: bool,
     #[serde(flatten)]
     state: Arc<RwLock<ProxyState>>,
 
@@ -527,6 +530,7 @@ impl DemandProxyState {
         *rb.options_mut() = dns_resolver_opts;
         let dns_resolver = rb.build();
         Self {
+            require_inbound_mtls: false,
             state,
             demand,
             dns_resolver,
@@ -534,6 +538,11 @@ impl DemandProxyState {
         }
     }
 
+    pub(crate) fn with_require_inbound_mtls(mut self, required: bool) -> Self {
+        self.require_inbound_mtls = required;
+        self
+    }
+
     pub fn read(&self) -> RwLockReadGuard<'_, ProxyState> {
         self.state.read().unwrap()
     }
@@ -544,7 +553,28 @@ impl DemandProxyState {
     ) -> Result<(), proxy::AuthorizationRejectionError> {
         let wl = &ctx.dest_workload;
         let conn = &ctx.conn;
+        if self.require_inbound_mtls && conn.src_identity.is_none() {
+            authpol_log!(
+                reason = "authentication-required",
+                "verified TLS peer required"
+            );
+            return Err(proxy::AuthorizationRejectionError::AuthenticationRequired);
+        }
         let state = self.read();
+        if self.require_inbound_mtls {
+            for required in &wl.authorization_policies {
+                if state.policies.get(required).is_none() {
+                    authpol_log!(
+                        policy = required.as_str(),
+                        reason = "required-policy-missing",
+                        "required authorization unavailable"
+                    );
+                    return Err(proxy::AuthorizationRejectionError::MissingPolicy(
+                        required.clone(),
+                    ));
+                }
+            }
+        }
 
         // We can get policies from namespace, global, and workload...
         let ns = state.policies.get_by_namespace(&wl.namespace);
@@ -1134,7 +1164,8 @@ impl ProxyStateManager {
                 config.dns_resolver_cfg.clone(),
                 config.dns_resolver_opts.clone(),
                 proxy_metrics,
-            ),
+            )
+            .with_require_inbound_mtls(config.require_inbound_mtls),
         })
     }
 
@@ -1484,6 +1515,94 @@ mod tests {
         )
     }
 
+    #[tokio::test]
+    async fn required_mtls_rejects_plaintext_without_dynamic_policies() {
+        let mut state = ProxyState::new(None);
+        state.workloads.insert(Arc::new(create_workload(1)));
+        let strict = create_state(state).with_require_inbound_mtls(true);
+        let mut ctx = get_rbac_context(&strict, 1, "client");
+        assert!(strict.assert_rbac(&ctx).await.is_ok());
+        ctx.conn.src_identity = None;
+        for port in [1, 80, 8080, 9443, 65535] {
+            ctx.conn.dst.set_port(port);
+            assert_eq!(
+                strict.assert_rbac(&ctx).await,
+                Err(proxy::AuthorizationRejectionError::AuthenticationRequired)
+            );
+        }
+        // The compatibility default retains the upstream permissive behavior.
+        let permissive = strict.clone().with_require_inbound_mtls(false);
+        assert!(permissive.assert_rbac(&ctx).await.is_ok());
+        assert!(strict.require_inbound_mtls);
+    }
+
+    #[tokio::test]
+    async fn required_mtls_survives_allow_policy_and_policy_cache_loss() {
+        let mut state = ProxyState::new(None);
+        state.workloads.insert(Arc::new(create_workload(1)));
+        let mut allow = create_dry_run_wildcard_rbac_policy(rbac::RbacAction::Allow);
+        allow.dry_run = false;
+        state.policies.insert("ns1/wildcard".into(), allow);
+        let strict = create_state(state).with_require_inbound_mtls(true);
+        let mut ctx = get_rbac_context(&strict, 1, "client");
+        assert!(strict.assert_rbac(&ctx).await.is_ok());
+        ctx.conn.src_identity = None;
+        assert_eq!(
+            strict.assert_rbac(&ctx).await,
+            Err(proxy::AuthorizationRejectionError::AuthenticationRequired)
+        );
+        strict.state.write().unwrap().policies = PolicyStore::default();
+        assert_eq!(
+            strict.assert_rbac(&ctx).await,
+            Err(proxy::AuthorizationRejectionError::AuthenticationRequired)
+        );
+    }
+
+    #[tokio::test]
+    async fn required_mtls_holds_missing_references_and_preserves_explicit_denies() {
+        let mut state = ProxyState::new(None);
+        let mut workload = create_workload(1);
+        workload.authorization_policies = vec!["ns1/wildcard".into()];
+        state.workloads.insert(Arc::new(workload));
+        let strict = create_state(state).with_require_inbound_mtls(true);
+        let ctx = get_rbac_context(&strict, 1, "client");
+        let missing = Err(proxy::AuthorizationRejectionError::MissingPolicy(
+            "ns1/wildcard".into(),
+        ));
+        assert_eq!(strict.assert_rbac(&ctx).await, missing);
+        let mut allow = create_dry_run_wildcard_rbac_policy(rbac::RbacAction::Allow);
+        allow.dry_run = false;
+        strict
+            .state
+            .write()
+            .unwrap()
+            .policies
+            .insert("ns1/wildcard".into(), allow);
+        assert!(strict.assert_rbac(&ctx).await.is_ok());
+        strict
+            .state
+            .write()
+            .unwrap()
+            .policies
+            .remove("ns1/wildcard".into());
+        assert_eq!(strict.assert_rbac(&ctx).await, missing);
+        let mut deny = create_dry_run_wildcard_rbac_policy(rbac::RbacAction::Deny);
+        deny.dry_run = false;
+        strict
+            .state
+            .write()
+            .unwrap()
+            .policies
+            .insert("ns1/wildcard".into(), deny);
+        assert_eq!(
+            strict.assert_rbac(&ctx).await,
+            Err(proxy::AuthorizationRejectionError::ExplicitlyDenied(
+                "ns1".into(),
+                "wildcard".into()
+            ))
+        );
+    }
+
     fn create_dry_run_wildcard_rbac_policy(action: rbac::RbacAction) -> rbac::Authorization {
         rbac::Authorization {
             action,
