+type admissionLogOutput struct {
+	bytes.Buffer
+	retry chan struct{}
+}
+
+func (w *admissionLogOutput) Write(b []byte) (int, error) {
+	n, err := w.Buffer.Write(b)
+	if bytes.Contains(b, []byte("Endpoint startup admission retry")) {
+		select {
+		case w.retry <- struct{}{}:
+		default:
+		}
+	}
+	return n, err
+}
