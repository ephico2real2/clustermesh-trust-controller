+        let original =
+            "# HELP example Work in progress.\n# TYPE example gauge\nexample{worker=\"0\"} 9\n";
+        let changed = "# HELP example Work in progress.\n# TYPE example gauge\nexample{worker=\"0\"} 10\nexample{worker=\"1\"} 11\n";
