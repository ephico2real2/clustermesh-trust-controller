+                    // Owner cancellation is a real cleanup event, never an allow.
+                    drop(owner);
+                    assert!(
+                        tokio::time::timeout(Duration::from_secs(2), serving)
+                            .await
+                            .unwrap()
+                            .unwrap()
+                            .is_err()
+                    );
+                    let _ = tokio::time::timeout(Duration::from_secs(2), driver)
+                        .await
+                        .unwrap()
+                        .unwrap();
+                    drop(sender);
+                }
+            }
+        }
+    }
 }
