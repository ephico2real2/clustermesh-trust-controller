+// Lease publishers consume this snapshot rather than independently reading
+// endpoint atomics and concatenating states from different revisions.
 func (r *Registry) SourceSnapshot() SourceSnapshot {
 	r.mu.RLock()
 	defer r.mu.RUnlock()
