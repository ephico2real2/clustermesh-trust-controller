            "ports": [
              {
                "containerPort": 80,
                "name": "http",
                "protocol": "TCP"
              },
              {
                "containerPort": 8080,
                "name": "app-alt",
                "protocol": "TCP"
              },
              {
                "containerPort": 31337,
                "name": "app-high",
                "protocol": "TCP"
              }
            ],
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/usr/share/nginx/html",
                "name": "html"
              },
              {
                "mountPath": "/etc/nginx/conf.d/default.conf",
                "name": "nginx-conf",
                "subPath": "nginx.conf"
              }
            ]
          }
        ],
        "terminationGracePeriodSeconds": 5,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "rebel-base-response"
            },
            "name": "html"
          },
          {
            "configMap": {
              "defaultMode": 420,
              "name": "rebel-base-nginx"
            },
            "name": "nginx-conf"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "client-control-plane",
        "namespace": "cmtc-live-mtls",
        "labels": {
          "security.cmtc.io/test-owner": "cmtc-primary-live-mtls-20261025",
          "test-role": "client",
          "serving-cluster": "cmtc-a"
        }
      },
      "spec": {
        "nodeName": "cmtc-a-control-plane",
        "serviceAccountName": "mesh-client",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "client",
            "image": "curlimages/curl:8.14.1",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "sh",
              "-c",
              "sleep 86400"
            ]
          }
        ],
        "terminationGracePeriodSeconds": 5
