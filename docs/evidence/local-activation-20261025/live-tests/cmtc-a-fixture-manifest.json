{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "rebel-base-response",
        "namespace": "cmtc-live-mtls"
      },
      "data": {
        "index.html": "{\"cluster\": \"cmtc-a\", \"message\": \"served by the cmtc-a rebel base\"}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "rebel-base-nginx",
        "namespace": "cmtc-live-mtls"
      },
      "data": {
        "nginx.conf": "server {\n  listen 80;\n  listen 8080;\n  listen 31337;\n  default_type application/json;\n  add_header X-CMTC-Cluster \"cmtc-a\" always;\n  add_header X-CMTC-Pod $hostname always;\n  location / { root /usr/share/nginx/html; }\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "rebel-base",
        "namespace": "cmtc-live-mtls"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "mesh-client",
        "namespace": "cmtc-live-mtls"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "unregistered",
        "namespace": "cmtc-live-mtls-unauth"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "server-worker",
        "namespace": "cmtc-live-mtls",
        "labels": {
          "security.cmtc.io/test-owner": "cmtc-primary-live-mtls-20261025",
          "test-role": "server",
          "serving-cluster": "cmtc-a"
        }
      },
      "spec": {
        "nodeName": "cmtc-a-worker",
        "serviceAccountName": "rebel-base",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "image": "nginx:1.27-alpine",
            "imagePullPolicy": "IfNotPresent",
            "name": "nginx",
            "ports": [
              {
                "containerPort": 80,
                "name": "http",
                "protocol": "TCP"
              },
              {
                "containerPort": 8080,
                "name": "app-alt",
                "protocol": "TCP"
              },
              {
                "containerPort": 31337,
                "name": "app-high",
                "protocol": "TCP"
              }
            ],
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/usr/share/nginx/html",
                "name": "html"
              },
              {
                "mountPath": "/etc/nginx/conf.d/default.conf",
                "name": "nginx-conf",
                "subPath": "nginx.conf"
              }
            ]
          }
        ],
        "terminationGracePeriodSeconds": 5,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "rebel-base-response"
            },
            "name": "html"
          },
          {
            "configMap": {
              "defaultMode": 420,
              "name": "rebel-base-nginx"
            },
            "name": "nginx-conf"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "client-worker",
        "namespace": "cmtc-live-mtls",
        "labels": {
          "security.cmtc.io/test-owner": "cmtc-primary-live-mtls-20261025",
          "test-role": "client",
          "serving-cluster": "cmtc-a"
        }
      },
      "spec": {
        "nodeName": "cmtc-a-worker",
        "serviceAccountName": "mesh-client",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "client",
            "image": "curlimages/curl:8.14.1",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "sh",
              "-c",
              "sleep 86400"
            ]
          }
        ],
        "terminationGracePeriodSeconds": 5
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "unregistered-worker",
        "namespace": "cmtc-live-mtls-unauth",
        "labels": {
          "security.cmtc.io/test-owner": "cmtc-primary-live-mtls-20261025"
        }
      },
      "spec": {
        "nodeName": "cmtc-a-worker",
        "serviceAccountName": "unregistered",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "client",
            "image": "curlimages/curl:8.14.1",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "sh",
              "-c",
              "sleep 86400"
            ]
          }
        ]
      }
    },
