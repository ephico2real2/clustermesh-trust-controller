            "name": "tcp-80",
            "port": 80,
            "targetPort": 80
          },
          {
            "name": "tcp-8080",
            "port": 8080,
            "targetPort": 8080
          },
          {
            "name": "tcp-31337",
            "port": 31337,
            "targetPort": 31337
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "server-cmtc-b",
        "namespace": "cmtc-live-mtls",
