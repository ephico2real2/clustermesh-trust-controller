    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "unregistered-control-plane",
        "namespace": "cmtc-live-mtls-unauth",
        "labels": {
          "security.cmtc.io/test-owner": "cmtc-primary-live-mtls-20261025"
        }
      },
      "spec": {
        "nodeName": "cmtc-a-control-plane",
        "serviceAccountName": "unregistered",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "client",
            "image": "curlimages/curl:8.14.1",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "sh",
              "-c",
              "sleep 86400"
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "server-cmtc-a",
        "namespace": "cmtc-live-mtls",
        "annotations": {
          "service.cilium.io/global": "true"
        }
      },
      "spec": {
        "selector": {
          "test-role": "server",
          "serving-cluster": "cmtc-a"
        },
        "ports": [
