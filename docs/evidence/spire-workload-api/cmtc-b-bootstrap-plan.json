        "agent.conf": "agent {\n  data_dir = \"/run/spire/data\"\n  log_level = \"ERROR\"\n  server_address = \"spire-server.cilium-spire.svc\"\n  server_port = \"8081\"\n  socket_path = \"/run/spire/sockets/agent/agent.sock\"\n  admin_socket_path = \"/run/spire/sockets/admin/admin.sock\"\n  authorized_delegates = [\"spiffe://cmtc-b.mesh.example/ztunnel-proxy\"]\n  trust_bundle_path = \"/run/spire/bundle/bundle.crt\"\n  trust_domain = \"cmtc-b.mesh.example\"\n}\n\nplugins {\n  NodeAttestor \"k8s_psat\" {\n    plugin_data {\n      cluster = \"cmtc-b\"\n      token_path = \"/var/run/secrets/tokens/spire-agent\"\n    }\n  }\n\n  KeyManager \"memory\" {\n    plugin_data {\n    }\n  }\n\n  WorkloadAttestor \"k8s\" {\n    plugin_data {\n      skip_kubelet_verification = false\n      kubelet_ca_path = \"/run/cmtc-kubelet/serving.pem\"\n      node_name_env = \"CMTC_NODE_NAME\"\n      use_new_container_locator = true\n      max_poll_attempts = 4\n      poll_retry_interval = \"250ms\"\n    }\n  }\n}\n\nhealth_checks {\n  listener_enabled = true\n  bind_address = \"0.0.0.0\"\n  bind_port = \"4251\"\n  live_path = \"/live\"\n  ready_path = \"/ready\"\n}\n"
