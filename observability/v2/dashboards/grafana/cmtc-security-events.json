      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4e79a7"
          },
          "noValue": "Not scraped yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      }
    },
    {
      "type": "table",
      "title": "Denied callers in the last hour, top 10",
      "description": "The ten caller and destination identities with the most denials in the last hour, read from the raw counter at query time (principals are not kept in a recorded series: one per ServiceAccount).",
      "id": 4,
