  "title": "CMTC security events",
  "uid": "cmtc-v2-security",
  "description": "What was denied, what was revoked, and how long did revocation take? One reporter per event: the destination ztunnel for policy denials, the reporter that refused for revocations, the Cilium agent for datapath drops and for plan acknowledgment.",
  "tags": [
    "cmtc",
    "cmtc-v2"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cmtc-v2"
      ],
      "asDropdown": false,
      "title": "CMTC v2",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "What did policy deny?",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connections denied by policy per second",
      "description": "Connections the destination's ztunnel denied by policy, per cluster, 5 minute rate. The caller's ztunnel sees the same connection as a failure and is not counted again.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (cluster) (rate(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\", cluster=\"cmtc-a\"}[5m]))",
          "legendFormat": "{{cluster}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (cluster) (rate(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\", cluster=\"cmtc-b\"}[5m]))",
          "legendFormat": "{{cluster}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e15759"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Denied connections in the last hour, by namespace pair",
      "description": "Denied connections by caller namespace and destination namespace, largest first, last hour.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
