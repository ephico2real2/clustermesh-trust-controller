        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cluster"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "cmtc-a": {
                        "color": "#4e79a7",
                        "index": 0
                      },
                      "cmtc-b": {
                        "color": "#e15759",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Denials, 1 h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "cluster": 0,
              "source_principal": 1,
              "destination_principal": 2,
              "Value": 3
            },
            "renameByName": {
              "cluster": "Cluster",
              "source_principal": "Caller",
              "destination_principal": "Destination",
              "Value": "Denials, 1 h"
            }
          }
