        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(sum by (source_workload_namespace, destination_workload_namespace) (increase(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\"}[1h])) > 0)",
          "legendFormat": "{{source_workload_namespace}} to {{destination_workload_namespace}}",
          "instant": true
