        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (cluster, source_principal, destination_principal) (increase(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\"}[1h])) > 0)",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
