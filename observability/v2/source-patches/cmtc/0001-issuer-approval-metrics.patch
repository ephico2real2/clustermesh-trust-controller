+// An approval pins at most two issuers per cluster: the gauges report the newest and the oldest by notAfter, a
+// single issuer at both positions, and drop a cluster that left the approval without a reset.
+func TestApprovalGaugesPositionsAndDeparture(t *testing.T) {
+	now := time.Date(2026, 10, 26, 12, 0, 0, 0, time.UTC)
+	m, err := NewMetrics(prometheus.NewRegistry(), "cmtc-a")
+	if err != nil {
