+			want := 0.0
+			if other == reason {
+				want = 1
+			}
+			if got := testutil.ToFloat64(m.Reason.WithLabelValues(other)); got != want {
+				t.Fatalf("after %s: %s = %v, want %v", reason, other, got, want)
+			}
+		}
+	}
+	if n := testutil.CollectAndCount(m.Reason); n != len(Reasons)+1 {
+		t.Fatalf("%d reason series, want the %d reasons and the unknown one", n, len(Reasons)+1)
+	}
+}
