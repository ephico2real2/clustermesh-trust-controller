+// Every reason is exported from the start, and exactly one is 1 after each decision; a reason outside Reasons is
+// exported too rather than hidden.
+func TestPublicationReasonIsOneHot(t *testing.T) {
+	m, err := NewMetrics(prometheus.NewRegistry(), "cmtc-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := testutil.CollectAndCount(m.Reason); n != len(Reasons) {
