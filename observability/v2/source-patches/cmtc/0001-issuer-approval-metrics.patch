+
+// SetReason records the reason of a pass's publication decision: 1 for it, 0 for every other reason. A reason
+// outside Reasons is exported too, so that a new reason shows instead of hiding a withdrawal.
+func (m *Metrics) SetReason(reason string) {
+	m.Reason.WithLabelValues(reason).Set(1)
+	for _, other := range Reasons {
+		if other != reason {
+			m.Reason.WithLabelValues(other).Set(0)
+		}
+	}
+}
+
+// SetApproval records the approval of an API-acknowledged publication and the time it ends (Validated.Until), or
+// nil after an acknowledged withdrawal. Validate canonicalizes every certificate of an approval it returns, so an
+// error means the caller passed an approval that Validate did not return; the other clusters are still recorded.
+func (m *Metrics) SetApproval(a *Approval, until time.Time) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	current := map[string]bool{}
+	var errs []error
+	if a != nil {
+		for _, c := range a.Clusters {
+			pinned, err := pinnedIssuers(c)
+			if err != nil {
+				errs = append(errs, fmt.Errorf("approval cluster %s: %w", c.ClusterID, err))
+				continue
+			}
+			for position, cert := range pinned {
+				m.IssuerNotBefore.WithLabelValues(c.ClusterID, position).Set(float64(cert.NotBefore.Unix()))
+				m.IssuerNotAfter.WithLabelValues(c.ClusterID, position).Set(float64(cert.NotAfter.Unix()))
+			}
+			current[c.ClusterID] = true
+		}
+	}
+	for id := range m.approvalClusters {
+		if !current[id] {
+			for _, position := range Positions {
+				m.IssuerNotBefore.DeleteLabelValues(id, position)
+				m.IssuerNotAfter.DeleteLabelValues(id, position)
+			}
+		}
+	}
+	m.approvalClusters = current
+	generation, end := 0.0, 0.0
+	if a != nil {
+		generation, end = float64(a.Generation), float64(until.Unix())
+	}
+	m.ApprovalGeneration.Set(generation)
+	m.ApprovalUntil.Set(end)
+	return errors.Join(errs...)
+}
+
+// pinnedIssuers returns the issuers of one approval cluster at each position of Positions, by notAfter.
+func pinnedIssuers(c Cluster) (map[string]*x509.Certificate, error) {
+	var newest, oldest *x509.Certificate
+	for _, issuer := range c.Issuers {
+		cert, err := oneCertificate(issuer.CertificatePEM)
+		if err != nil {
+			return nil, err
+		}
+		if newest == nil || cert.NotAfter.After(newest.NotAfter) {
+			newest = cert
+		}
+		if oldest == nil || cert.NotAfter.Before(oldest.NotAfter) {
+			oldest = cert
+		}
+	}
+	if newest == nil {
+		return nil, errors.New("no pinned issuer")
+	}
+	return map[string]*x509.Certificate{"newest": newest, "oldest": oldest}, nil
+}
