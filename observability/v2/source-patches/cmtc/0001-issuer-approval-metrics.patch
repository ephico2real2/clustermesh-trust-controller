@@ -0,0 +1,144 @@
+package controller
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/ephico2real2/clustermesh-trust-controller/internal/trustprofile"
+	"github.com/prometheus/client_golang/prometheus"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+// gaugeValue reads the first gauge series of a family whose labels include labels: its value, and whether it exists.
+func gaugeValue(t *testing.T, reg *prometheus.Registry, name string, labels map[string]string) (float64, bool) {
+	t.Helper()
+	families, err := reg.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, family := range families {
+		if family.GetName() != name {
+			continue
+		}
+		for _, metric := range family.Metric {
+			got := map[string]string{}
+			for _, label := range metric.Label {
+				got[label.GetName()] = label.GetValue()
+			}
+			match := true
+			for k, v := range labels {
+				match = match && got[k] == v
+			}
+			if match {
+				return metric.GetGauge().GetValue(), true
+			}
+		}
+	}
+	return 0, false
+}
+
+// publicationReason returns the reason the reason gauge sets to 1, "" when none is, after checking that the gauge
+// exports exactly the reasons of trustprofile.Reasons.
+func publicationReason(t *testing.T, reg *prometheus.Registry) string {
+	t.Helper()
+	families, err := reg.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, family := range families {
+		if family.GetName() == "cmtc_issuer_profile_publication_reason" && len(family.Metric) != len(trustprofile.Reasons) {
+			t.Fatalf("%d reason series, want %d: a reason outside trustprofile.Reasons", len(family.Metric), len(trustprofile.Reasons))
+		}
+	}
+	var set []string
+	for _, reason := range trustprofile.Reasons {
+		value, ok := gaugeValue(t, reg, "cmtc_issuer_profile_publication_reason", map[string]string{"reason": reason})
+		if !ok {
+			t.Fatalf("reason %s is not exported", reason)
+		}
+		if value == 1 {
+			set = append(set, reason)
+		}
+	}
+	if len(set) > 1 {
+		t.Fatalf("several reasons set: %v", set)
+	}
+	if len(set) == 0 {
+		return ""
+	}
+	return set[0]
+}
+
+// The approval gauges are the clock of issuer succession (#34): consumers pin the approval the acknowledged
+// publication carries, and its newest issuer's notAfter decides when SPIRE activates a CA the approval does not pin.
+// The reason gauge says why the producer withdrew. Both follow the acknowledged publication.
+func TestIssuerApprovalAndReasonGaugesFollowThePublication(t *testing.T) {
+	r, c, _, _, now, reg := producerFixture(t)
+	start := *now
+	if got := publicationReason(t, reg); got != "" {
+		t.Fatalf("reason %s before the first pass", got)
+	}
+	reconcileProfile(t, r)
+	if _, p := readProfile(t, c, r.Options.Output); p.State != "published" {
+		t.Fatalf("fixture did not publish: %s", p.Reason)
+	}
+	if got := publicationReason(t, reg); got != "Validated" {
+		t.Fatalf("reason %s after a publication", got)
+	}
+	// The fixture approval ends at its expiresAt, an hour on, before its issuers (two hours) and its root (a day).
+	approval := map[string]float64{
+		"cmtc_issuer_profile_approval_generation":                    1,
+		"cmtc_issuer_profile_approval_valid_until_timestamp_seconds": float64(start.Add(time.Hour).Unix()),
+	}
+	for name, want := range approval {
+		if got, ok := gaugeValue(t, reg, name, nil); !ok || got != want {
+			t.Fatalf("%s = %v, want %v", name, got, want)
+		}
+	}
+	for _, cluster := range []string{"cmtc-a", "cmtc-b"} {
+		for _, position := range trustprofile.Positions {
+			labels := map[string]string{"approval_cluster": cluster, "position": position}
+			if got, ok := gaugeValue(t, reg, "cmtc_issuer_profile_approved_issuer_not_after_timestamp_seconds", labels); !ok || got != float64(start.Add(2*time.Hour).Unix()) {
+				t.Fatalf("not_after %v = %v", labels, got)
+			}
+			if got, ok := gaugeValue(t, reg, "cmtc_issuer_profile_approved_issuer_not_before_timestamp_seconds", labels); !ok || got != float64(start.Add(-time.Minute).Unix()) {
+				t.Fatalf("not_before %v = %v", labels, got)
+			}
+		}
+	}
+
+	// Past expiresAt the producer withdraws: the gauges drop the approval and the reason says why.
+	*now = start.Add(time.Hour + time.Second)
+	reconcileProfile(t, r)
+	if _, p := readProfile(t, c, r.Options.Output); p.State != "withdrawn" || p.Reason != "SourceExpired" {
+		t.Fatalf("expired approval gave %s %s", p.State, p.Reason)
+	}
+	if got := publicationReason(t, reg); got != "SourceExpired" {
+		t.Fatalf("reason %s after the approval expired", got)
+	}
+	for name := range approval {
+		if got, _ := gaugeValue(t, reg, name, nil); got != 0 {
+			t.Fatalf("%s = %v after the withdrawal", name, got)
+		}
+	}
+	if _, ok := gaugeValue(t, reg, "cmtc_issuer_profile_approved_issuer_not_after_timestamp_seconds", nil); ok {
+		t.Fatal("a withdrawn publication still exports its issuers")
+	}
+
+	// A pass that cannot read the source records its own reason, though the pass fails.
+	c.getHook = func(_ context.Context, key client.ObjectKey, _ client.Object) error {
+		if key == r.Options.Source {
+			return errors.New("API unavailable")
+		}
+		return nil
+	}
+	if _, err := r.Reconcile(context.Background(), ctrl.Request{}); err == nil {
+		t.Fatal("source error not returned")
+	}
+	if got := publicationReason(t, reg); got != "SourceUnavailable" {
+		t.Fatalf("reason %s after a failed source read", got)
+	}
+}
