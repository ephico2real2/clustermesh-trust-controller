+		return makeCA(t, root, now, func(c *x509.Certificate) { c.NotBefore, c.NotAfter = now.Add(start), now.Add(end) })
+	}
+	slotA, slotB, other := window(-20*time.Hour, 4*time.Hour), window(-8*time.Hour, 16*time.Hour), window(-time.Hour, 23*time.Hour)
