            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "sum by (cluster) (rate(cilium_drop_count_total{job=\"cilium-native\", cluster=\"cmtc-b\"}[5m]))",
                  "seriesNameFormat": "{{cluster}}"
