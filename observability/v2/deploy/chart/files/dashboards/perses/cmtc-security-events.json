    "3_0": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Narrowed plan acknowledged by ztunnel, 99th percentile, seconds \u00b7 planned",
          "description": "Planned, a proposed source change: needs source-patches/cilium/0001 (acknowledgment histogram). For plans republished because a caller was removed (a policy revocation), the time until ztunnel acknowledged them, per cluster, from the histogram over 1 hour (narrowings are rare). Until then the removed caller can still connect."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "querySettings": [
              {
                "areaOpacity": 0.1,
                "colorMode": "fixed",
                "colorValue": "#4e79a7",
                "queryIndex": 0
              },
              {
                "areaOpacity": 0.1,
                "colorMode": "fixed",
                "colorValue": "#e15759",
                "lineStyle": "dashed",
                "queryIndex": 1
              }
            ],
            "visual": {
              "areaOpacity": 0.1,
              "connectNulls": false,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "seconds"
              },
              "min": 0
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "histogram_quantile(0.99, sum by (cluster, le) (rate(cilium_ztunnel_xds_effective_policy_ack_duration_seconds_bucket{job=\"cilium-native\", cause=\"caller_removed\", cluster=\"cmtc-a\"}[1h])))",
                  "seriesNameFormat": "{{cluster}}"
                }
              }
            }
          },
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "histogram_quantile(0.99, sum by (cluster, le) (rate(cilium_ztunnel_xds_effective_policy_ack_duration_seconds_bucket{job=\"cilium-native\", cause=\"caller_removed\", cluster=\"cmtc-b\"}[1h])))",
                  "seriesNameFormat": "{{cluster}}"
