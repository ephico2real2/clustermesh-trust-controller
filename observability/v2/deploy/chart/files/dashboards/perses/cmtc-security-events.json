{
  "display": {
    "name": "CMTC security events"
  },
  "variables": [],
  "panels": {
    "0_0": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Connections denied by policy per second \u00b7 proposed",
          "description": "Proposed: needs the ztunnel scrape job of deploy/. Connections the destination's ztunnel denied by policy, per cluster, 5 minute rate. The caller's ztunnel sees the same connection as a failure and is not counted again."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "querySettings": [
              {
                "areaOpacity": 0.1,
                "colorMode": "fixed",
                "colorValue": "#4e79a7",
                "queryIndex": 0
              },
              {
                "areaOpacity": 0.1,
                "colorMode": "fixed",
                "colorValue": "#e15759",
                "lineStyle": "dashed",
                "queryIndex": 1
              }
            ],
            "visual": {
              "areaOpacity": 0.1,
              "connectNulls": false,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "counts/sec"
              },
              "min": 0
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "sum by (cluster) (rate(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\", cluster=\"cmtc-a\"}[5m]))",
                  "seriesNameFormat": "{{cluster}}"
                }
              }
            }
          },
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "sum by (cluster) (rate(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\", cluster=\"cmtc-b\"}[5m]))",
                  "seriesNameFormat": "{{cluster}}"
                }
              }
            }
          }
        ]
      }
    },
    "0_1": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Denied connections in the last hour, by namespace pair \u00b7 proposed",
          "description": "Proposed: needs the ztunnel scrape job of deploy/. Denied connections by caller namespace and destination namespace, largest first, last hour."
        },
        "plugin": {
          "kind": "BarChart",
          "spec": {
            "calculation": "last-number",
            "format": {
              "unit": "decimal"
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "sort_desc(sum by (source_workload_namespace, destination_workload_namespace) (increase(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\"}[1h])) > 0)",
                  "seriesNameFormat": "{{source_workload_namespace}} to {{destination_workload_namespace}}"
                }
              }
            }
          }
        ]
      }
    },
    "0_2": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Denied callers in the last hour, top 10 \u00b7 proposed",
          "description": "Proposed: needs the ztunnel scrape job of deploy/. The ten caller and destination identities with the most denials in the last hour, read from the raw counter at query time (principals are not kept in a recorded series: one per ServiceAccount)."
        },
        "plugin": {
          "kind": "Table",
          "spec": {
            "columnSettings": [
              {
                "cellSettings": [
                  {
                    "backgroundColor": "#4e79a7",
                    "condition": {
                      "kind": "Value",
                      "spec": {
                        "value": "cmtc-a"
                      }
                    },
                    "textColor": "#000000"
                  },
                  {
                    "backgroundColor": "#e15759",
                    "condition": {
                      "kind": "Value",
                      "spec": {
                        "value": "cmtc-b"
                      }
                    },
                    "textColor": "#000000"
                  }
                ],
                "header": "Cluster",
                "name": "cluster"
              },
              {
                "header": "Caller",
                "name": "source_principal"
              },
              {
                "header": "Destination",
                "name": "destination_principal"
              },
              {
                "format": {
                  "unit": "decimal"
                },
                "header": "Denials, 1 h",
                "name": "value"
              },
              {
                "hide": true,
                "name": "timestamp"
              }
            ],
            "density": "compact",
            "transforms": [
              {
                "kind": "MergeSeries",
                "spec": {}
              }
            ]
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "topk(10, sum by (cluster, source_principal, destination_principal) (increase(istio_tcp_connections_failed_total{job=\"ztunnel\", reporter=\"destination\", response_flags=\"DENY\"}[1h])) > 0)",
                  "seriesNameFormat": ""
                }
              }
            }
          }
        ]
      }
    },
    "0_3": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "How to read this section"
        },
        "plugin": {
          "kind": "Markdown",
          "spec": {
            "text": "A denial is the policy working. A caller that keeps being denied is the finding: the table names it."
          }
        }
      }
    },
    "1_0": {
