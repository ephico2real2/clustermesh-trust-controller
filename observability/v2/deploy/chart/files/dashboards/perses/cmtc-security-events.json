    "2_1": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Revocation refusals, 1 hour \u00b7 proposed",
          "description": "Proposed: needs the ztunnel scrape job of deploy/, with istio_crl_* kept. Connections refused or closed for a revoked certificate in the last hour, per cluster. 0 is normal."
        },
        "plugin": {
          "kind": "StatChart",
          "spec": {
            "calculation": "last-number",
            "colorMode": "value",
            "format": {
              "decimalPlaces": 0,
              "unit": "decimal"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "#59a14f",
                  "value": 0
                },
                {
                  "color": "#f28e2b",
                  "value": 1
                }
              ]
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "cmtc-thanos"
                  },
                  "query": "sum by (cluster) (increase(istio_crl_policy_rejections_total{job=\"ztunnel\", cluster=\"cmtc-a\"}[1h])) or 0 * max by (cluster) (up{job=\"ztunnel\", cluster=\"cmtc-a\"} == 1)",
                  "seriesNameFormat": "{{cluster}}"
                }
              }
            }
          },
          {
            "kind": "TimeSeriesQuery",
            "spec": {
