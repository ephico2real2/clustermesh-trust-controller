        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cmtc_pods_pending)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods Enforcement Failed",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
