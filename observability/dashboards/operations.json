{
  "uid": "cmtc-observe-lab",
  "title": "CMTC | Operations",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "cmtc",
    "observe"
  ],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "CMTC Prometheus",
          "value": "cmtc-prom"
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(cmtc_enforcement_available{job=\"cmtc\",component=\"cmtc-controller\"},cluster)",
          "refId": "ClusterVariable"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "CMTC operations · observed intent and inventory",
      "type": "text",
      "description": "Visible context and scope; documented status is not a live health metric.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Observe mode:** namespace selection, existing enrollment labels, node inventory and controller activity are live. **Enforcement verification is unavailable.** These readings do not establish workload protection.\n\nUse the cluster selector for one cluster or both. Blue identifies cmtc-a; red identifies cmtc-b in charts and table cells. [Workload mTLS evidence](https://github.com/ephico2real2/clustermesh-trust-controller/blob/1c192a5ee84fb5218cb1385fdd9c5bf45ca69e1a/2026-10-24T0509Z-local-authenticated-only-f052d127/README.md) is a separate isolated trial."
      }
    },
    {
      "id": 2,
      "title": "Is CMTC reporting?",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "title": "Controllers reporting",
      "type": "stat",
      "description": "Latest controller metric series at range end, one per reporting controller. Not application or datapath readiness.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4e79a7"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(cmtc_enforcement_available{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Node inventories ready",
      "type": "stat",
      "description": "Latest successful local inventory observations at range end. Not encrypted or protected node counts.",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4e79a7"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cmtc_node_agent_ready{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-node-agent\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Namespaces selected · intent",
      "type": "stat",
      "description": "Latest namespace selection intent at range end. The Observe controller does not change labels or enforce traffic.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4e79a7"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cmtc_namespaces_selected{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Enforcement verification",
      "type": "stat",
      "description": "Native CMTC capability gauge at range end. Zero means verification is unavailable in Observe mode; missing telemetry remains unavailable.",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f28e2b"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "#f28e2b"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cmtc_enforcement_available{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Which namespaces are selected?",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "title": "Enrollment labels observed",
      "type": "stat",
      "description": "Latest namespaces carrying the Cilium enrollment label from any actor. Label presence is intent, not protection.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4e79a7"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cmtc_namespaces_enrolled{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Non-platform namespaces observed",
      "type": "stat",
      "description": "Latest non-platform namespace inventory, including explicitly excluded namespaces; not a count of safe-to-enroll namespaces.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4e79a7"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cmtc_namespaces_eligible{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Namespace decisions · latest share",
      "type": "piechart",
      "description": "Latest namespace decisions at the selected range end. Selected, excluded, platform and unselected are disjoint and sum to all observed namespaces in the selected clusters. This is inventory/intent, not mTLS coverage. Missing telemetry stays unavailable.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Selected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Excluded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e15759"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Platform"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#edc948"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unselected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b07aa1"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cmtc_namespace_decisions{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\",decision=\"selected\"} @ end())",
          "legendFormat": "Selected",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(cmtc_namespace_decisions{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\",decision=\"excluded\"} @ end())",
          "legendFormat": "Excluded",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum(cmtc_namespace_decisions{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\",decision=\"platform\"} @ end())",
          "legendFormat": "Platform",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "sum(cmtc_namespace_decisions{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\",decision=\"unselected\"} @ end())",
          "legendFormat": "Unselected",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Namespace decisions by cluster",
      "type": "table",
      "description": "Latest namespace decision gauges at range end, one row per cluster and decision. Zero is an observed empty category; a missing controller is not zero.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cluster"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "cmtc-a": {
                        "text": "cmtc-a",
                        "color": "#4e79a7"
                      },
                      "cmtc-b": {
                        "text": "cmtc-b",
                        "color": "#e15759"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Decision"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "selected": {
                        "text": "Selected",
                        "color": "#4e79a7"
                      },
                      "excluded": {
                        "text": "Excluded",
                        "color": "#e15759"
                      },
                      "platform": {
                        "text": "Platform",
                        "color": "#edc948"
                      },
                      "unselected": {
                        "text": "Unselected",
                        "color": "#b07aa1"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(cluster,decision) (cmtc_namespace_decisions{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "cluster": 0,
              "decision": 1,
              "Value": 2
            },
            "renameByName": {
              "cluster": "Cluster",
              "decision": "Decision",
              "Value": "Namespaces"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Read the namespace categories",
      "type": "text",
      "description": "Visible context and scope; documented status is not a live health metric.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Selected** = policy intent. **Excluded** = explicit exclusion. **Platform** = protected infrastructure. **Unselected** = remaining namespaces.\n\nThe pie includes platform namespaces in its denominator. Non-platform inventory includes excluded namespaces. Enrollment labels are observed from any actor. None of these counts proves mTLS or Protected status."
      }
    },
    {
      "id": 13,
      "title": "Do controllers and node agents keep up?",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 14,
      "title": "Metrics targets reachable",
      "type": "stat",
      "description": "Latest successful scrapes at range end. The two-cluster lab expects six: two controllers plus four node agents. Filtered views have fewer targets. Scrape reachability is not workload protection.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#59a14f"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"cmtc\",cluster=~\"$cluster\",component=~\"cmtc-controller|cmtc-node-agent\"} @ end())",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 15,
      "title": "Controller reconcile errors/s",
      "type": "stat",
      "description": "Controller-runtime reconcile errors per second over the adaptive rate interval. An observed zero means no recorded errors; missing data is unavailable.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f28e2b"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 40
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(controller_runtime_reconcile_errors_total{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 16,
      "title": "Policy evaluations/s · by cluster",
      "type": "timeseries",
      "description": "Successful CMTC policy evaluations per second over $__rate_interval. A fall to zero can mean idle work; it is not protection readiness. Missing metrics remain unavailable.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cmtc-a"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cmtc-b"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e15759"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(cluster) (rate(cmtc_policy_evaluations_total{job=\"cmtc\",cluster=~\"$cluster\",component=\"cmtc-controller\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 17,
      "title": "Controller reconcile p95 · seconds",
      "type": "timeseries",
      "description": "95th-percentile controller-runtime reconcile duration from real histogram buckets, over $__rate_interval. It measures controller work, not network or TLS latency. No observations mean the percentile is unavailable.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cmtc-a"
            },
            "properties": [
              {
                "id": "color",
