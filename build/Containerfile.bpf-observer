# Pass the qualified Linux ARM64 Go/clang builder by its immutable image ID.
# See LOCAL_DATAPATH_OBSERVER.md; this image does not enforce mTLS.
ARG BUILD_IMAGE
FROM ${BUILD_IMAGE} AS build
ARG SOURCE_SHA
WORKDIR /workspace
COPY go.mod go.sum ./
RUN test "${#SOURCE_SHA}" -eq 40 && go mod download
COPY cmd/cmtc-bpf-observer ./cmd/cmtc-bpf-observer
COPY internal/datapath ./internal/datapath
RUN clang -target bpfel -O2 -g -Wall -Werror -c internal/datapath/bpf/observer.c -o /tmp/observer_bpfel.o
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-X main.sourceRevision=${SOURCE_SHA}" -o /tmp/cmtc-bpf-observer ./cmd/cmtc-bpf-observer

FROM scratch
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision=$SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/ephico2real2/clustermesh-trust-controller"
COPY --from=build /tmp/cmtc-bpf-observer /cmtc-bpf-observer
COPY --from=build /tmp/observer_bpfel.o /usr/share/cmtc/observer_bpfel.o
USER 0
ENTRYPOINT ["/cmtc-bpf-observer"]
