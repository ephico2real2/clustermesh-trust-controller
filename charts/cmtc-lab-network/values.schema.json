{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cmtc-lab-network values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingress",
    "coredns"
  ],
  "properties": {
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "interfaces"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))?$"
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coredns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "zones"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "address"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"
              },
              "address": {
                "type": "string",
                "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
              }
            }
          }
        }
      }
    }
  }
}
